# Copy to .env.local (dev) or set in your hosting provider (production).

# Admin panel login. In production both are required; in dev the demo login admin / demo12345 is used if unset.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret for signing session cookies, at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
